# Notion Integration (Personal Access Token from developers.notion.com)
NOTION_API_KEY=ntn_your_personal_access_token_here
NOTION_TOKEN=ntn_your_integration_token_here
NOTION_DATABASE_ID=your_database_id_here

# Google Cloud Platform (ADC is used for production; define for bucket target)
GCP_PROJECT_ID=your-gcp-project-id
GCS_BUCKET_NAME=schemata-diagram-assets

# Authentication (Auth.js v5)
AUTH_SECRET=generate_with_openssl_rand_base64_32
AUTH_GITHUB_ID=your_github_oauth_client_id
AUTH_GITHUB_SECRET=your_github_oauth_client_secret
ADMIN_EMAIL=your.email@example.com

# Application URL
NEXT_PUBLIC_APP_URL=https://schemata-your-service-hash.run.app
PORT=8080
HOSTNAME=0.0.0.0
